<?xml version="1.0" encoding="utf-8"?>
<!-- SYNTHETIC DATA · for training only · no OSFI data -->
<!-- rpt_fda_institution_return: quarterly supervisory return per institution (paginated report, Letter portrait). -->
<!-- Data source: sm_fda_supervisory (Power BI semantic model). __TENANT_ID__ / __DATASET_ID__ are replaced by 01-Deploy-FdaEnvironment.ps1. -->
<!-- VERIFY: PBIDATASET connect string format; Report Builder rewrites it when you re-select the model (paginated/README-paginated.md). -->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="sm_fda_supervisory">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, __TENANT_ID__";Initial Catalog=sobe_wowvirtualserver-__DATASET_ID__;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3f6b2a8e-1c4d-4f7a-9e2b-fda000000001</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsInstitutions"><Query><DataSourceName>sm_fda_supervisory</DataSourceName><CommandText>// SYNTHETIC DATA - institution list for the Institution parameter
EVALUATE
SELECTCOLUMNS(
    dim_institution,
    "code", dim_institution[institution_code],
    "label", dim_institution[institution_name] &amp; " (" &amp; dim_institution[institution_code] &amp; ")"
)
ORDER BY [label]</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="code"><DataField>[code]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="label"><DataField>[label]</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet>
    <DataSet Name="dsReturn"><Query><DataSourceName>sm_fda_supervisory</DataSourceName><QueryParameters><QueryParameter Name="InstitutionList"><Value>=Join(Parameters!Institution.Value, "|")</Value></QueryParameter></QueryParameters><CommandText>// SYNTHETIC DATA - last 8 quarters of key ratios for the selected institutions
DEFINE
    MEASURE fact_insurance_capital[Insurer Watch Threshold (report)] =
        VAR _type = SELECTEDVALUE(dim_institution[institution_type])
        RETURN
            CALCULATE(
                MAX(supervisory_watch_thresholds[watch_threshold]),
                supervisory_watch_thresholds[metric] IN {"LICAT total", "MCT"},
                supervisory_watch_thresholds[institution_type] = _type
            )
    VAR _currentIndex = CALCULATE(MAX(dim_quarter[quarter_index]), dim_quarter[is_current] = TRUE())
EVALUATE
SUMMARIZECOLUMNS(
    dim_institution[institution_code],
    dim_institution[institution_name],
    dim_institution[institution_type],
    dim_institution[supervisory_lead],
    dim_quarter[quarter_key],
    dim_quarter[quarter_label],
    FILTER(VALUES(dim_institution[institution_code]), PATHCONTAINS(@InstitutionList, dim_institution[institution_code])),
    FILTER(VALUES(dim_quarter[quarter_index]), dim_quarter[quarter_index] &gt; _currentIndex - 8),
    "Reporting", [Institutions Reporting],
    "CET1Ratio", [CET1 Ratio],
    "Tier1Ratio", [Tier 1 Ratio],
    "TotalCapitalRatio", [Total Capital Ratio],
    "LeverageRatio", [Leverage Ratio],
    "LCR", [LCR],
    "NSFR", [NSFR],
    "InsuranceCapitalRatio", [Insurance Capital Ratio],
    "CET1WatchThreshold", [CET1 Watch Threshold],
    "InsurerWatchThreshold", [Insurer Watch Threshold (report)]
)
ORDER BY dim_institution[institution_code], dim_quarter[quarter_key]</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="institution_code"><DataField>dim_institution[institution_code]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="institution_name"><DataField>dim_institution[institution_name]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="institution_type"><DataField>dim_institution[institution_type]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="supervisory_lead"><DataField>dim_institution[supervisory_lead]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="quarter_key"><DataField>dim_quarter[quarter_key]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="quarter_label"><DataField>dim_quarter[quarter_label]</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Reporting"><DataField>[Reporting]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="CET1Ratio"><DataField>[CET1Ratio]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Tier1Ratio"><DataField>[Tier1Ratio]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="TotalCapitalRatio"><DataField>[TotalCapitalRatio]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="LeverageRatio"><DataField>[LeverageRatio]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="LCR"><DataField>[LCR]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="NSFR"><DataField>[NSFR]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="InsuranceCapitalRatio"><DataField>[InsuranceCapitalRatio]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="CET1WatchThreshold"><DataField>[CET1WatchThreshold]</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="InsurerWatchThreshold"><DataField>[InsurerWatchThreshold]</DataField><rd:TypeName>System.Double</rd:TypeName></Field></Fields></DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="tblReturn"><TablixBody><TablixColumns><TablixColumn><Width>0.95in</Width></TablixColumn><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>0.75in</Width></TablixColumn><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>0.75in</Width></TablixColumn><TablixColumn><Width>0.75in</Width></TablixColumn><TablixColumn><Width>0.75in</Width></TablixColumn><TablixColumn><Width>0.85in</Width></TablixColumn><TablixColumn><Width>0.9in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.38in</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtInstitutionName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Quarterly supervisory return — " &amp; Fields!institution_name.Value &amp; " (" &amp; Fields!institution_code.Value &amp; ")"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F1F1F</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtInstitutionName</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>9</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtInstitutionDetails"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!institution_type.Value &amp; " · Lead supervisor: " &amp; Fields!supervisory_lead.Value &amp; " · Last 8 quarters · Red = below internal watch threshold (illustrative)"</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtInstitutionDetails</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>9</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="hdr0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Quarter</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr0</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>CET1 ratio</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr1</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Tier 1 ratio</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr2</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total capital</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr3</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Leverage</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr4</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>LCR</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr5</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>NSFR</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr6</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>LICAT / MCT</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr7</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="hdr8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Watch threshold</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>hdr8</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><BackgroundColor>#1FB58F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="val0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!quarter_label.Value &amp; IIF(IsNothing(Fields!Reporting.Value), " (not filed)", "")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#1F1F1F</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val0</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="val1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CET1Ratio.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>0.00%</Format><Color>=IIF(Not IsNothing(Fields!CET1Ratio.Value) And Not IsNothing(Fields!CET1WatchThreshold.Value) And Fields!CET1Ratio.Value &lt; Fields!CET1WatchThreshold.Value, "#C00000", "#1F1F1F")</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val1</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="val2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Tier1Ratio.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>0.00%</Format><Color>#1F1F1F</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val2</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="val3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TotalCapitalRatio.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>0.00%</Format><Color>#1F1F1F</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultN
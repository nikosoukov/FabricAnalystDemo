Runs><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val6</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="val7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!InsuranceCapitalRatio.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>0.0%</Format><Color>=IIF(Not IsNothing(Fields!InsuranceCapitalRatio.Value) And Not IsNothing(Fields!InsurerWatchThreshold.Value) And Fields!InsuranceCapitalRatio.Value &lt; Fields!InsurerWatchThreshold.Value, "#C00000", "#1F1F1F")</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val7</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="val8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Fields!institution_type.Value = "Life insurer" Or Fields!institution_type.Value = "P&amp;C insurer", Fields!InsurerWatchThreshold.Value, Fields!CET1WatchThreshold.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>0.0%</Format><Color>#1F1F1F</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>val8</rd:DefaultName><Style><Border><Color>#D9D9D9</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><Group Name="grpInstitution"><GroupExpressions><GroupExpression>=Fields!institution_code.Value</GroupExpression></GroupExpressions><PageBreak><BreakLocation>Between</BreakLocation></PageBreak></Group><SortExpressions><SortExpression><Value>=Fields!institution_code.Value</Value></SortExpression></SortExpressions><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage><KeepTogether>true</KeepTogether></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage><KeepTogether>true</KeepTogether></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage><KeepTogether>true</KeepTogether></TablixMember><TablixMember><Group Name="grpDetails" /><SortExpressions><SortExpression><Value>=Fields!quarter_key.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>dsReturn</DataSetName><NoRowsMessage>No data for the selected institution(s).</NoRowsMessage><Top>0in</Top><Left>0in</Left><Height>1.23in</Height><Width>7.3in</Width><Style><Border><Style>None</Style></Border></Style></Tablix>
          <Textbox Name="txtNote"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ratios = sum of components / sum of exposures from sm_fda_supervisory. Watch thresholds are internal and illustrative, not OSFI regulatory minimums. SYNTHETIC DATA · for training only · no OSFI data.</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtNote</rd:DefaultName><Top>1.35in</Top><Left>0in</Left><Height>0.3in</Height><Width>7.3in</Width><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox>
        </ReportItems>
        <Height>1.7in</Height>
        <Style />
